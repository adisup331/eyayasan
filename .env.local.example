# Supabase — isi dari dashboard Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY, JANGAN diawali NEXT_PUBLIC.
# Dipakai Server Action registrasi/reset password (lib/supabase/admin.ts).
# Ambil dari Settings -> API -> service_role (secret). JANGAN commit nilai asli.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
